generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id                  String    @id @default(cuid())
  email               String?   @unique
  passwordHash        String?
  nombre              String
  apellidos           String
  telefono            String?
  telefonoAlternativo String?
  fechaNacimiento     DateTime?
  dniNie              String?   @unique
  rol                 Rol       @default(USUARIO)
  emailVerificado     Boolean   @default(false)

  // TOTP (verificación en dos pasos, basado en Authenticator/Authy/1Password).
  // El secret se almacena cifrado con AES-256-GCM usando TOTP_ENCRYPTION_KEY.
  // Es null hasta que el usuario activa el segundo factor.
  totpSecret           String?
  totpEnabled          Boolean @default(false)
  lastAcceptedTotpStep Int?

  // Incrementar ante cualquier cambio de credenciales, rol o MFA invalida
  // inmediatamente todos los JWT emitidos con una versión anterior.
  authVersion        Int       @default(0)
  authFailedAttempts Int       @default(0)
  authLockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tutorias                      Tutoria[]               @relation("TutorUsuarios")
  jugadorComoUsuario            Jugador?                @relation("JugadorComoUsuario")
  entrenadorComoUsuario         Entrenador?             @relation("EntrenadorComoUsuario")
  invitacionesCreadas           Invitacion[]            @relation("AdminCreadorInvitacion")
  invitacionesRecibidas         Invitacion[]            @relation("UsuarioInvitado")
  passwordResetTokens           PasswordResetToken[]
  pendingRegistrationsCreadas   PendingRegistration[]   @relation("AdminCreadorPendingReg")
  recibosCreados                Recibo[]                @relation("ReciboCreador")
  solicitudesDocumentosCreadas  SolicitudDocumento[]    @relation("SolicitudDocumentoCreador")
  consentimientosCreados        Consentimiento[]        @relation("ConsentimientoCreador")
  consentimientosFirmados       ConsentimientoJugador[] @relation("ConsentimientoFirmante")
  entrenadoresCreados           Entrenador[]            @relation("EntrenadorCreador")
  auditoriasRGPD                AuditoriaRGPD[]         @relation("AuditoriaRGPD Ejecutor")
  auditoriasSeguridadEjecutadas AuditoriaSeguridad[]    @relation("AuditoriaSeguridad Ejecutor")
  auditoriasSeguridadAfectadas  AuditoriaSeguridad[]    @relation("AuditoriaSeguridad Afectado")
}

model AuditoriaSeguridad {
  id String @id @default(cuid())

  accion  String
  detalle Json?

  ejecutadoPorId String?
  ejecutadoPor   Usuario? @relation("AuditoriaSeguridad Ejecutor", fields: [ejecutadoPorId], references: [id], onDelete: SetNull)

  usuarioAfectadoId String?
  usuarioAfectado   Usuario? @relation("AuditoriaSeguridad Afectado", fields: [usuarioAfectadoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([usuarioAfectadoId, createdAt])
}

model NotificacionPendiente {
  id           String    @id @default(cuid())
  destinatario String
  titulo       String
  detalle      String
  url          String?
  intentos     Int       @default(0)
  ultimoError  String?
  enviadoAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([destinatario, enviadoAt, createdAt])
  @@index([enviadoAt, createdAt])
}

// ============================================
// JUGADORES
// ============================================

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

model Jugador {
  id                  String   @id @default(cuid())
  nombre              String
  apellidos           String
  fechaNacimiento     DateTime
  dniNie              String?  @unique
  email               String?
  telefono            String?
  telefonoAlternativo String?
  direccion           String?
  fotoUrl             String?
  sexo                Sexo?

  // Si el jugador es adulto y tiene cuenta propia, este campo apunta a su Usuario.
  // En ese caso, los datos personales del jugador (nombre, apellidos, email, teléfono)
  // son los del Usuario. La sincronización se hace al editar el perfil.
  // Si no tiene cuenta propia, los datos están directamente en este registro.
  usuario   Usuario? @relation("JugadorComoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId String?  @unique

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tutorias              Tutoria[]
  asignaciones          AsignacionEquipo[]
  invitaciones          Invitacion[]
  pendingRegistrations  PendingRegistration[]
  recibosJugador        ReciboJugador[]
  documentosSolicitados SolicitudDocumentoJugador[]
  consentimientos       ConsentimientoJugador[]
  entrenadorComoJugador Entrenador?                 @relation("EntrenadorComoJugador")

  @@index([apellidos, nombre])
  @@index([fechaNacimiento])
}

// Tabla intermedia: un Jugador puede tener varios Usuarios como tutores/padres.
// Un mismo Usuario puede ser tutor de varios Jugadores (sus hijos).
model Tutoria {
  id        String  @id @default(cuid())
  jugador   Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  jugadorId String
  usuario   Usuario @relation("TutorUsuarios", fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  parentesco  String? // "Padre", "Madre", "Tutor legal", "Jugador titular"
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([jugadorId, usuarioId])
  @@index([usuarioId])
}

model Invitacion {
  id           String  @id @default(cuid())
  token        String  @unique @default(cuid())
  emailDestino String
  tipo         String // "REGISTRO" o "VINCULACION"
  mensaje      String?

  // Jugador al que se refiere la invitación
  jugador   Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  jugadorId String

  // Admin que creó la invitación
  creadaPor   Usuario? @relation("AdminCreadorInvitacion", fields: [creadaPorId], references: [id], onDelete: SetNull)
  creadaPorId String?

  // Usuario que aceptó la invitación (si ya existía)
  usuarioAcepta   Usuario? @relation("UsuarioInvitado", fields: [usuarioAceptaId], references: [id], onDelete: SetNull)
  usuarioAceptaId String?

  expirada  Boolean   @default(false)
  usada     Boolean   @default(false)
  fechaUso  DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([emailDestino])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  usado     Boolean   @default(false)
  fechaUso  DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([usuarioId])
}

// Token para activar una cuenta recién creada (por el admin) o un jugador sin tutor.
// El usuario aún no tiene passwordHash, debe introducirlo para activar la cuenta.
model PendingRegistration {
  id        String  @id @default(cuid())
  token     String  @unique @default(cuid())
  email     String  @unique
  nombre    String
  apellidos String
  telefono  String?

  // Si es una activación de un jugador que ya existe, guardamos su id.
  jugador             Jugador? @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  jugadorId           String?
  // Si es activación de un usuario nuevo que se vinculará a un jugador existente al activarse.
  // (cuando el admin crea un jugador con un nuevo email para el padre y luego quiere que ese email sea la cuenta)
  jugadorParaVincular String?

  // Si viene de una creación de jugador por parte del admin, guardamos quién lo creó.
  creadoPor   Usuario? @relation("AdminCreadorPendingReg", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  usado     Boolean   @default(false)
  fechaUso  DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

// ============================================
// TEMPORADAS Y EQUIPOS
// ============================================

model Temporada {
  id          String   @id @default(cuid())
  nombre      String   @unique // "2026/2027"
  fechaInicio DateTime
  fechaFin    DateTime
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipos           Equipo[]
  entrenadorEquipos EntrenadorEquipo[]
}

model Equipo {
  id          String  @id @default(cuid())
  nombre      String
  codigoFcf   String? @unique
  categoria   String? // "Benjamín", "Alevín", "Senior", etc.
  descripcion String?
  urlLiga     String? // URL a la página oficial de la federación/liga

  temporada   Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  temporadaId String

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones                   AsignacionEquipo[]
  recibos                        Recibo[]                    @relation("ReciboEquipoLegacy")
  recibosAsignados               Recibo[]                    @relation("ReciboEquipos")
  recibosJugadoresOrigen         ReciboJugador[]             @relation("ReciboJugadorEquiposOrigen")
  solicitudesDocumentos          SolicitudDocumento[]        @relation("SolicitudDocumentoEquipoLegacy")
  solicitudesDocumentosAsignadas SolicitudDocumento[]        @relation("SolicitudDocumentoEquipos")
  documentosJugadoresOrigen      SolicitudDocumentoJugador[] @relation("SolicitudDocumentoJugadorEquiposOrigen")
  consentimientosAsignados       Consentimiento[]            @relation("ConsentimientoEquipos")
  consentimientosJugadoresOrigen ConsentimientoJugador[]     @relation("ConsentimientoJugadorEquiposOrigen")
  horariosEntrenamiento          HorarioEntrenamiento[]
  entrenadoresAsignaciones       EntrenadorEquipo[]

  @@unique([nombre, temporadaId])
  @@index([temporadaId])
}

model HorarioEntrenamiento {
  id           String @id @default(cuid())
  equipo       Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  equipoId     String
  diaSemana    Int // 1 = lunes, 7 = domingo
  minutoInicio Int // Minutos desde las 00:00
  minutoFin    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipoId, diaSemana, minutoInicio, minutoFin])
  @@index([equipoId, diaSemana, minutoInicio])
}

// ============================================
// ENTRENADORES
// ============================================

// Entrenador del club. Una persona puede ser entrenador y a la vez
// jugador (Entrenador.jugadorId) o tener cuenta de acceso (Entrenador.usuarioId).
model Entrenador {
  id                  String  @id @default(cuid())
  nombre              String
  apellidos           String
  email               String?
  telefono            String?
  telefonoAlternativo String?
  observaciones       String?

  // Cuenta de acceso opcional. Si se vincula, el usuario puede ver su portal
  // desde /dashboard / /dashboard/entrenador sin necesidad de ser admin.
  usuario   Usuario? @relation("EntrenadorComoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId String?  @unique

  // Ficha de jugador opcional. Si este entrenador también juega como
  // jugador en algún equipo del club, podemos vincular su Jugador.
  jugador   Jugador? @relation("EntrenadorComoJugador", fields: [jugadorId], references: [id], onDelete: SetNull)
  jugadorId String?  @unique

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creadoPor   Usuario? @relation("EntrenadorCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  equipos EntrenadorEquipo[]

  @@index([apellidos, nombre])
  @@index([activo])
}

// Asignación de un Entrenador a uno o varios Equipos.
// Si la asignación caduca (fechaHasta) o cambia de temporada, se elimina esta fila
// y se crea una nueva en vez de mantener histórico histórico.
model EntrenadorEquipo {
  id           String     @id @default(cuid())
  entrenador   Entrenador @relation(fields: [entrenadorId], references: [id], onDelete: Cascade)
  entrenadorId String
  equipo       Equipo     @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  equipoId     String

  // Rol dentro del cuerpo técnico del equipo
  rol String @default("ENTRENADOR_PRINCIPAL")
  // "ENTRENADOR_PRINCIPAL" | "ENTRENADOR_AYUDANTE" | "PREPARADOR_FISICO" | "COORDINADOR"

  // Opcional: atado a una temporada concreta. Si es null, la asignación
  // es independiente de la temporada (cualquier temporada activa).
  temporada   Temporada? @relation(fields: [temporadaId], references: [id], onDelete: SetNull)
  temporadaId String?

  observaciones String?
  createdAt     DateTime @default(now())

  @@unique([entrenadorId, equipoId, rol])
  @@index([entrenadorId])
  @@index([equipoId])
  @@index([temporadaId])
}

model AsignacionEquipo {
  id        String  @id @default(cuid())
  jugador   Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  jugadorId String
  equipo    Equipo  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  equipoId  String

  fechaAsignacion DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([jugadorId, equipoId])
  @@index([equipoId])
  @@index([jugadorId])
}

// ============================================
// RECIBOS
// ============================================

// Datos fiscales y de contacto del club (emisor de los recibos).
// Se modela como singleton: una única fila con id=1.
model ConfiguracionClub {
  id            Int      @id @default(1)
  nombre        String // Razón social del club
  codigoFcf     String? // Código identificativo de la Federació Catalana de Futbol
  logoKey       String?
  colorPrimario String   @default("#1d4ed8")
  nif           String? // NIF / CIF del club
  direccion     String? // Dirección fiscal
  codigoPostal  String?
  ciudad        String?
  provincia     String?
  pais          String   @default("España")
  telefono      String?
  email         String?
  web           String?
  // Porcentaje de IVA por defecto para nuevos recibos
  ivaPorDefecto Decimal  @default(21) @db.Decimal(5, 2)
  // Prefijo del número de recibo (ej. "R" → R-001234)
  prefijoRecibo String   @default("R")
  updatedAt     DateTime @updatedAt
}

enum EstadoRecibo {
  PENDIENTE
  PAGADO
  ANULADO
}

// Recibo: documento emitido por el club a uno o varios jugadores.
// equipoId conserva compatibilidad con recibos antiguos de un único equipo.
// Las nuevas asignaciones por equipo se guardan en equipos.
// Los jugadores concretos asignados están en ReciboJugador.
model Recibo {
  id          Int     @id @default(autoincrement())
  concepto    String
  descripcion String?

  baseImponible Decimal @db.Decimal(10, 2)
  tipoIva       Decimal @db.Decimal(5, 2) // % (ej. 21.00)
  cuotaIva      Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  fechaEmision     DateTime  @default(now())
  fechaVencimiento DateTime?

  // Si está pagado (todos sus ReciboJugador PAGADO)
  estado EstadoRecibo @default(PENDIENTE)

  // Metadatos del pago a nivel de recibo (opcional)
  fechaPago      DateTime?
  metodoPago     String?
  referenciaPago String?
  notasPago      String?

  // Origen de la asignación
  equipo   Equipo?  @relation("ReciboEquipoLegacy", fields: [equipoId], references: [id], onDelete: SetNull)
  equipoId String?
  equipos  Equipo[] @relation("ReciboEquipos")

  jugadores ReciboJugador[]

  // PDF generado (key en S3). Null hasta que se regenere.
  pdfKey String?

  creadoPor   Usuario? @relation("ReciboCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([fechaEmision])
  @@index([equipoId])
}

enum EstadoReciboJugador {
  PENDIENTE
  RECHAZADO
  PAGADO
  ANULADO
}

// Asignación de un Recibo a un Jugador concreto con su estado de pago.
// Si el Recibo se asignó a un equipo, se crea una fila por cada jugador del equipo
// en el momento de la creación del recibo (snapshot).
model ReciboJugador {
  id        String  @id @default(cuid())
  numero    Int     @unique @default(autoincrement())
  recibo    Recibo  @relation(fields: [reciboId], references: [id], onDelete: Cascade)
  reciboId  Int
  jugador   Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  jugadorId String

  estado EstadoReciboJugador @default(PENDIENTE)

  asignadoDirectamente Boolean  @default(true)
  equiposOrigen        Equipo[] @relation("ReciboJugadorEquiposOrigen")

  // Pago
  fechaPago      DateTime?
  metodoPago     String?
  referenciaPago String?
  notasPago      String?

  pagoDeclaradoAt         DateTime?
  pagoDeclaradoPorNombre  String?
  pagoDeclaradoPorEmail   String?
  pagoDeclaradoPorEsTutor Boolean?
  pagoRechazadoAt         DateTime?
  ultimoMotivoRechazoPago String?

  // Justificante subido por el jugador (en S3)
  justificanteKey              String?
  justificanteNombre           String?
  justificanteMime             String?
  justificanteSubidoAt         DateTime?
  justificanteSubidoPorNombre  String?
  justificanteSubidoPorEmail   String?
  justificanteSubidoPorEsTutor Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reciboId, jugadorId])
  @@index([jugadorId])
  @@index([estado])
}

// ============================================
// DOCUMENTOS SOLICITADOS
// ============================================

enum EstadoDocumentoJugador {
  PENDIENTE
  SUBIDO
  VALIDADO
}

// Solicitud creada por el club y asignada a uno o varios jugadores.
// equipoId conserva compatibilidad con solicitudes antiguas de un único equipo.
// Las nuevas asignaciones por equipo se guardan en equipos.
model SolicitudDocumento {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?

  equipo   Equipo?  @relation("SolicitudDocumentoEquipoLegacy", fields: [equipoId], references: [id], onDelete: SetNull)
  equipoId String?
  equipos  Equipo[] @relation("SolicitudDocumentoEquipos")

  jugadores SolicitudDocumentoJugador[]

  creadoPor   Usuario? @relation("SolicitudDocumentoCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipoId])
  @@index([createdAt])
}

// Estado y archivo aportado para un jugador concreto.
model SolicitudDocumentoJugador {
  id          String             @id @default(cuid())
  solicitud   SolicitudDocumento @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  solicitudId String
  jugador     Jugador            @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  jugadorId   String

  estado EstadoDocumentoJugador @default(PENDIENTE)

  asignadoDirectamente Boolean  @default(true)
  equiposOrigen        Equipo[] @relation("SolicitudDocumentoJugadorEquiposOrigen")

  archivoKey              String?
  archivoNombre           String?
  archivoMime             String?
  archivoSubidoAt         DateTime?
  archivoSubidoPorNombre  String?
  archivoSubidoPorEmail   String?
  archivoSubidoPorEsTutor Boolean?

  validadoAt          DateTime?
  rechazadoAt         DateTime?
  ultimoMotivoRechazo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([solicitudId, jugadorId])
  @@index([jugadorId])
  @@index([estado])
}

// ============================================
// CONSENTIMIENTOS
// ============================================

enum EstadoConsentimientoJugador {
  PENDIENTE
  FIRMADO
}

model Consentimiento {
  id          String @id @default(cuid())
  titulo      String
  descripcion String

  equipos Equipo[] @relation("ConsentimientoEquipos")

  jugadores ConsentimientoJugador[]

  creadoPor   Usuario? @relation("ConsentimientoCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model ConsentimientoJugador {
  id               String                      @id @default(cuid())
  consentimiento   Consentimiento              @relation(fields: [consentimientoId], references: [id], onDelete: Cascade)
  consentimientoId String
  jugador          Jugador                     @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  jugadorId        String
  estado           EstadoConsentimientoJugador @default(PENDIENTE)

  asignadoDirectamente Boolean  @default(true)
  equiposOrigen        Equipo[] @relation("ConsentimientoJugadorEquiposOrigen")

  pdfKey String?

  firmadoAt         DateTime?
  firmadoPor        Usuario?  @relation("ConsentimientoFirmante", fields: [firmadoPorId], references: [id], onDelete: SetNull)
  firmadoPorId      String?
  firmadoPorNombre  String?
  firmadoPorEmail   String?
  firmadoPorEsTutor Boolean?

  // Revocación del consentimiento (RGPD o manual).
  // Si está poblado, el consentimiento firmado se considera revocado en esta fecha,
  // aunque conservamos el PDF firmado en S3 como prueba legal del consentimiento original.
  revocadoAt     DateTime?
  revocadoMotivo String? // "ELIMINACION_RGPD" | "REVOCACION_MANUAL" | ...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consentimientoId, jugadorId])
  @@index([jugadorId])
  @@index([estado])
}

// ============================================
// AUDITORÍA RGPD
// ============================================

// Registro inmutable de operaciones RGPD (eliminaciones, anonimizaciones, revocaciones).
// El campo `usuarioAfectadoId` se guarda como texto (no FK) para que el registro
// sobreviva al borrado del Usuario y permita acreditar el cumplimiento ante una auditoría.
model AuditoriaRGPD {
  id String @id @default(cuid())

  // Snapshot del sujeto afectado (no FK, sobrevive al borrado del Usuario/Jugador).
  sujetoTipo           String // "USUARIO" | "JUGADOR" | "ENTRENADOR"
  sujetoAfectadoId     String
  sujetoAfectadoEmail  String?
  sujetoAfectadoNombre String?

  ejecutadoPorId String?
  ejecutadoPor   Usuario? @relation("AuditoriaRGPD Ejecutor", fields: [ejecutadoPorId], references: [id], onDelete: SetNull)

  accion    String // "ELIMINACION_USUARIO_RGPD" | "ELIMINACION_JUGADOR_RGPD" | ...
  detalle   Json // entidades afectadas (ids), nº consentimientos revocados, etc.
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sujetoAfectadoId])
}
