# Copia este archivo a .env y rellena los valores antes de hacer docker compose up

# === Base de datos ===
# password o azure-managed-identity
DATABASE_AUTH_MODE=password
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=control_equipos
# DB_PORT=5432

# Se usan cuando DATABASE_AUTH_MODE=azure-managed-identity
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_DATABASE=control_equipos
AZURE_POSTGRES_USER=
AZURE_POSTGRES_SCHEMA=public
AZURE_POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# Número máximo de conexiones por proceso
DATABASE_POOL_MAX=10

# === Aplicación ===
# Genera una clave segura con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-una-clave-segura-de-al-menos-32-caracteres

# URL pública de la aplicación (sin slash final)
AUTH_URL=http://localhost:3000

# Puerto en el que se expone la app (opcional, por defecto 3000)
# APP_PORT=3000

# === Email (opcional pero recomendado) ===
# Crea una cuenta en https://resend.com y obtén tu API key
RESEND_API_KEY=
EMAIL_FROM=Control de Equipos <noreply@example.com>
# Los avisos de recibos, documentos y consentimientos se agrupan por destinatario.
EMAIL_DIGEST_WINDOW_SECONDS=120
EMAIL_DIGEST_POLL_SECONDS=30

# Nombre público de la app
NEXT_PUBLIC_APP_NAME=Control de Equipos

# === Almacenamiento privado ===
# Valores permitidos: s3 (por defecto) o azure
STORAGE_PROVIDER=s3

# --- S3 compatible (MinIO en Docker) ---
# Los datos se persisten en S3_DATA_DIR (por defecto ~/.control-equipos/s3-data)
# Para npm run dev se accede a MinIO mediante el puerto publicado en localhost.
# Docker Compose sustituye este endpoint por http://s3:9000 dentro del contenedor.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=control-equipos
S3_SECRET_KEY=control-equipos-secret
S3_BUCKET=control-equipos-documents
S3_FORCE_PATH_STYLE=true
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
# S3_DATA_DIR=~/.control-equipos/s3-data

# --- Azure Blob Storage ---
# Se usan cuando STORAGE_PROVIDER=azure. El contenedor se crea como privado
# automáticamente si no existe.
# managed-identity (recomendado en Azure) o connection-string (desarrollo local)
AZURE_STORAGE_AUTH_MODE=managed-identity
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=control-equipos-documents

# Opcional: client ID si App Service usa una identidad administrada asignada
# por el usuario. Déjalo vacío para usar la identidad asignada por el sistema.
AZURE_MANAGED_IDENTITY_CLIENT_ID=
