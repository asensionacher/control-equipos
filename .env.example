# Copia este archivo a .env y rellena los valores antes de hacer docker compose up

# === Base de datos ===
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=control_equipos
# DB_PORT=5432

# === Aplicación ===
# Genera una clave segura con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-una-clave-segura-de-al-menos-32-caracteres

# URL pública de la aplicación (sin slash final)
AUTH_URL=http://localhost:3000

# Puerto en el que se expone la app (opcional, por defecto 3000)
# APP_PORT=3000

# === Email (opcional pero recomendado) ===
# Crea una cuenta en https://resend.com y obtén tu API key
RESEND_API_KEY=
EMAIL_FROM=Control de Equipos <noreply@example.com>

# Nombre público de la app
NEXT_PUBLIC_APP_NAME=Control de Equipos
